+void ps5_vertex_invalidate(uint32_t flags, uint32_t addr, uint32_t size) {
+  // Only an invalidation of attribute buffers (GX2_INVALIDATE_MODE_ATTRIBUTE_BUFFER, bit 0) says
+  // vertex data changed. The game also invalidates "everything" about 190 times a frame for other
+  // kinds (CPU caches, textures, shaders); counting those ended the interval 190 times a frame and
+  // left 12% of the repeated ranges reused. The contract still holds within a submission: the game
+  // waits at GX2DrawDone before it rewrites a buffer the draws read (gx2_core.cpp, render_sync).
+  static uint64_t kinds[8];
+  ++kinds[__builtin_ctz(flags | 0x80) & 7];
+  if (++kinds[7] % 60000 == 0)
