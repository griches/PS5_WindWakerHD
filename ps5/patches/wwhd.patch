+      s->addr == aoPrivateSource && aoPrivateFrame == R.frame &&
+      sh->kind == gfx::ProgramKind::OcclusionPixel) {
+    s = &aoPrivateColor;
+    if (substituted) *substituted = true;
+  }
+  upload_surface(s);
+  return s;
