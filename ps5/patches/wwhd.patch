+static const Ps5Box* ps5_position_box(uint32_t addr, uint32_t size, uint32_t stride, uint32_t offset) {
+  uint64_t h = (uint64_t(addr) * 0x9E3779B97F4A7C15ull) ^ (uint64_t(size) << 17) ^ (uint64_t(stride) << 7) ^ offset;
+  Ps5Box& b = ps5Boxes[size_t((h ^ (h >> 29)) * 0xBF58476D1CE4E5B9ull >> 52)];
+  const bool same = b.valid && b.addr == addr && b.size == size && b.stride == stride && b.offset == offset;
