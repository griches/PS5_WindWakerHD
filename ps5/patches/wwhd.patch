+// out = bias * light * inverseView (row-major, column vectors): the bias takes clip space to the
+// shadow map's texture space (x/2 + 1/2, -y/2 + 1/2, z/2 + 1/2)
+static void ps5_mask_matrix(const float* light, const float* inverseView, float* out) {
+  float lv[16];
+  for (int row = 0; row < 4; ++row)
+    for (int col = 0; col < 4; ++col) {
+      float sum = 0;
+      for (int k = 0; k < 4; ++k) sum += light[row * 4 + k] * inverseView[k * 4 + col];
+      lv[row * 4 + col] = sum;
+    }
+  for (int col = 0; col < 4; ++col) {
+    out[col] = 0.5f * lv[col] + 0.5f * lv[12 + col];
+    out[4 + col] = -0.5f * lv[4 + col] + 0.5f * lv[12 + col];
+    out[8 + col] = 0.5f * lv[8 + col] + 0.5f * lv[12 + col];
+    out[12 + col] = lv[12 + col];
+  }
