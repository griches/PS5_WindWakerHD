+        (unsigned long long)kinds[0], (unsigned long long)kinds[1], (unsigned long long)kinds[2], (unsigned long long)kinds[3],
+        (unsigned long long)kinds[4], (unsigned long long)kinds[5], (unsigned long long)kinds[6], (unsigned long long)kinds[7]);
+  if (!(flags & 1)) return;
+  if (!size || size >= 0x10000000u) { ++ps5VertexInterval; return; }  // "everything"
+  if (ps5InvalidateStamp.empty()) ps5InvalidateStamp.assign(size_t(1) << 20, 0);
